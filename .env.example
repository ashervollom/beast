# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Instant emoji tapback (small, fast) and the real reply (strong).
EMOJI_MODEL=claude-haiku-4-5
REPLY_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (medium keeps text replies snappy)
REPLY_EFFORT=medium

# --- Linq (iMessage) ---
# Dashboard -> API -> Overview -> Generate new token (https://dashboard.linqapp.com/api-tooling)
LINQ_API_KEY=
# Printed once by `npm run register-webhook`
LINQ_WEBHOOK_SECRET=
# Who can text the assistant (comma separated). Empty = anyone.
ALLOWED_HANDLES=
# The student this assistant belongs to
STUDENT_NAME=
STUDENT_HANDLE=+15555550123
# Other people the assistant should recognise by name (number=name, comma separated)
HANDLE_LABELS=

# --- Canvas (optional) ---
# Canvas -> Calendar -> "Calendar Feed" link. Anyone with this URL can read your calendar.
CANVAS_ICS_URL=
# Canvas REST API, used read-only to pull points, missing flags and submissions.
# Canvas -> Account -> Settings -> "New Access Token". Keep it secret.
CANVAS_BASE_URL=https://ucirvine.instructure.com
CANVAS_TOKEN=

# --- Server ---
PORT=3000
# Read-only dashboard for sharing through a tunnel (localhost only). Empty = off.
VIEWER_PORT=3001
# Public link to that read-only dashboard via Cloudflare (needs cloudflared installed). Beast texts it to you. "off" to disable.
TUNNEL=on
# Public https URL that tunnels to this server (ngrok, cloudflared, etc.)
PUBLIC_URL=https://your-tunnel.example.com
TIMEZONE=America/New_York
# Optional: password-protect the web dashboard (any username)
DASHBOARD_PASSWORD=

# --- Proactive texts (local time, 24h) ---
# Morning brief goes out every day at this time and doesn't count toward the cap
BRIEF_TIME=06:30
NIGHT_TIME=21:00
QUIET_START=23:00
QUIET_END=08:00
PROACTIVE_DAILY_CAP=4
# First deadline nudge when something is due within this many hours; final warning if still not started
NUDGE_HOURS=12
FINAL_NUDGE_HOURS=4
